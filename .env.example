# Supabase (required) — project URL and keys
SUPABASE_URL=
# Server-side PostgREST: service_role for background jobs and routes without user JWT context.
SUPABASE_KEY=
# Same project anon/public key — attached with each user's Bearer JWT so bucket Row Level Security passes on API routes.
SUPABASE_ANON_KEY=

# JWT validation for API requests.
# HS256 (legacy): copy JWT Secret from Dashboard → Project Settings → API (no extra spaces/quotes).
# RS256 (JWT signing keys): same secret is not used; backend verifies via JWKS — SUPABASE_URL must match the project.
SUPABASE_JWT_SECRET=
# Optional: JWT audience claim (default matches Supabase: authenticated)
# SUPABASE_JWT_AUDIENCE=authenticated

# Fernet key for encrypting Google OAuth tokens at rest (session + watch state).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_FERNET_KEY=

# API version string returned by /health and /ready
# MAILPULSE_VERSION=0.1.0

# OpenRouter (optional) — if unset, classification uses rule-based fallback only
OPENROUTER_API_KEY=
# Use model IDs from https://openrouter.ai/api/v1/models (filter :free); removed slugs return HTTP 404
# OPENROUTER_PRIMARY_MODEL=meta-llama/llama-3.2-3b-instruct:free
# OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
# Legacy alias (defaults match primary)
# OPENROUTER_MODEL=deepseek/deepseek-r1:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_HTTP_REFERER=http://localhost
# OPENROUTER_APP_TITLE=MailPulse
# OPENROUTER_TIMEOUT_SECONDS=10

# Per-user daily OpenRouter call counter (UTC midnight reset); default under backend/app/
# AI_DAILY_BUDGET_PATH=app/ai_daily_budget.json
# Max emails per OpenRouter classification request (inbox prefetch); 1–64
# AI_CLASSIFICATION_BATCH_SIZE=20

# Gmail Pub/Sub (required for push watches) — full topic resource name, e.g. projects/PROJECT/topics/TOPIC
GMAIL_PUBSUB_TOPIC=

# Google OAuth client secrets JSON path (defaults to backend/app/credentials.json if unset)
# GOOGLE_CREDENTIALS_PATH=app/credentials.json

# OAuth redirect must match the authorized redirect URI in Google Cloud Console
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Frontend URL used after OAuth success / failure redirects
FRONTEND_URL=http://localhost:3000

# CORS — comma-separated origins (include 127.0.0.1 if you open the app that way)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Starlette session signing secret — minimum 32 characters (use a long random string in production)
SESSION_SECRET=

# Session cookie options
# SESSION_MAX_AGE_SECONDS=604800
# SESSION_HTTPS_ONLY=false
# SESSION_SAME_SITE=lax

# Allow OAuth over http in local dev only (set false in production behind HTTPS)
OAUTHLIB_INSECURE_TRANSPORT=true

# Logging
# MAILPULSE_LOG_LEVEL=INFO

# Background Gmail safety sync (all mailboxes in watch-state on this machine). Set false locally if logs show old testers' mailboxes.
# MAILPULSE_FALLBACK_SCHEDULER_ENABLED=true

# Background scheduler intervals (seconds)
# MAILPULSE_FALLBACK_SYNC_SECONDS=720
# MAILPULSE_FOLLOWUP_SECONDS=600

# Gmail import/sync scaling
# GMAIL_BOOTSTRAP_MAX_MESSAGES=5000
# GMAIL_SYNC_WORKERS=4
# GMAIL_MESSAGE_FETCH_WORKERS=8

# AI disk cache file and TTL (hours per cache entry)
# AI_CACHE_PATH=app/ai_cache.json
# AI_CACHE_TTL_HOURS=24

# Google userinfo endpoint (normally leave default)
# GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo

# Where to write OAuth callback tracebacks on failure (relative to backend/ if not absolute)
# AUTH_ERROR_LOG_PATH=auth_error.log

# OAuth scopes (comma-separated; change only if you adjust Google Cloud consent)
# OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send,openid,https://www.googleapis.com/auth/userinfo.email
